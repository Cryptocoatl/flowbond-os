{
  // Neutral infra name on purpose — product branding lives in lib/brand.ts only.
  "name": "play",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "play.flowbond.life",
      "custom_domain": true
    }
  ]
  // R2 bucket binding for splats/audio/media added when the bucket exists:
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "kai-world-media" }]
}
