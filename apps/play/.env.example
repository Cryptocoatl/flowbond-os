# apps/play — copy to .env.local (never commit real values; secrets via `claudia keys`)

# Canonical Supabase project fgsrcxxccdjqyrpkitmk ("FlowBond-life")
NEXT_PUBLIC_SUPABASE_URL=https://fgsrcxxccdjqyrpkitmk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# R2 URL of the region splat (overrides the seed default)
NEXT_PUBLIC_SPLAT_URL=

# Feature flags
NEXT_PUBLIC_FLAG_DESCENT=0

# Co-op room server. Production uses the default baked into lib/net/room.ts
# (https://kai-room.cryptocoatl101.workers.dev). Override for local dev only —
# put it in .env.development.local so it never reaches a production build.
NEXT_PUBLIC_KAI_ROOM_URL=

# Optional TURN relay as JSON, if plain STUN cannot punch through a network.
NEXT_PUBLIC_KAI_TURN=
