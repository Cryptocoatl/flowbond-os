# Cloudflare Workers Assets serves everything under /_next/static, /logos,
# /icons and /favicon WITHOUT invoking the Worker, so these files never see the
# headers from next.config. Without this file, half the site ships unprotected.
# Next copies public/ into .open-next/assets/ at build time.
#
# Kept in sync with @flowbond/security `securityHeaders({ csp: false })`.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-DNS-Prefetch-Control: off
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
