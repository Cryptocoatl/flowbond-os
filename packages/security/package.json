{
  "name": "@flowbond/security",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./src/index.ts"
    },
    "./headers": {
      "import": "./dist/headers.mjs",
      "require": "./dist/headers.cjs",
      "types": "./src/headers.ts"
    },
    "./next": {
      "import": "./dist/next.mjs",
      "require": "./dist/next.cjs",
      "types": "./src/next.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@flowbond/config": "workspace:*",
    "typescript": "^5.7.3"
  }
